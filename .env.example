# ─────────────────────────────────────────────
# AmonaVision – Environment Configuration
# ─────────────────────────────────────────────
# Copy this file to .env and fill in the values.

# Telegram Bot Token (get it from @BotFather)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# Telegram Group Chat ID (where the photo frame sends voice replies, and where
# the Monday reminder goes -- see [Telegram] in config.txt). Get it with /chatid.
TELEGRAM_GROUP_CHAT_ID=your-group-chat-id-here

# Telegram chat ID that receives health-check alerts (a PERSON, not the group).
# Message the bot privately, then check app.log for "... from user id=<N>".
TELEGRAM_ADMIN_CHAT_ID=your-personal-chat-id-here

# Shared password for the LAN dashboard (http://<pi-ip>:8080).
# REQUIRED — amonavision-web.service refuses to start without it.
WEB_PASSWORD=choose-a-shared-family-password

# Samba password for the av user (the \\<pi-ip>\RaspberryPi share).
# setup.sh sets it; without it the share has no usable password.
SAMBA_PASSWORD=choose-a-samba-password
